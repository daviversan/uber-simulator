.venv/
__pycache__/
*.pyc
.env
.pytest_cache/
.DS_Store
*.pdf

# Certificado de proxy corporativo (Zscaler etc.) — específico da máquina, nunca vai pro git.
# As pastas certs/ em si são versionadas (via .gitkeep) para os Dockerfiles funcionarem
# em qualquer máquina; só os .crt dentro delas ficam de fora.
backend/certs/*.crt
!backend/certs/.gitkeep
simulator/certs/*.crt
!simulator/certs/.gitkeep
