# Copie para .env (cp .env.example .env). O .env não vai para o git.

# Postgres. O docker-compose monta a DATABASE_URL da API a partir destas três.
# A senha só é aplicada quando o volume do banco é criado; para trocá-la depois,
# use `docker compose down -v` (apaga os dados) ou ALTER USER no psql.
POSTGRES_USER=uber
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=uber

# Filtro de movimento do motorista (lidos por backend/app/settings.py)
MIN_MOVE_M=10
HEARTBEAT_S=30
STALE_AFTER_S=300
